# Porta exposta no host (Portainer / VPS). O container internamente sempre escuta na 3000.
HOST_PORT=3001

# URL pública onde a aplicação é alcançável. Exibida no QR/links.
# Exemplos:
#   PUBLIC_URL=http://190.89.248.194:3001
#   PUBLIC_URL=https://wa-archive.telenova.com.br
PUBLIC_URL=http://localhost:3001

# Token usado para login na UI admin e nas chamadas /api/*.
# Gere algo longo e aleatório, ex.: openssl rand -hex 32
ADMIN_TOKEN=troque-este-token-por-um-valor-aleatorio-longo

# Identificação do código implantado. GIT_SHA e BUILD_TIME podem ser
# preenchidos pelo processo de deploy para confirmar exatamente o build ativo.
APP_VERSION=1.1.4
BUILD_TIME=
GIT_SHA=

# Timeouts para contas grandes (900000 ms = 15 minutos).
# O primeiro controla chamadas CDP/Puppeteer; o segundo limita getChats().
PUPPETEER_PROTOCOL_TIMEOUT_MS=900000
GET_CHATS_TIMEOUT_MS=900000

# Limite máximo de mensagens recuperadas por chat (whatsapp-web.js fetchMessages).
# Aumente se precisar de mais histórico — lembrando que só vem o que já está
# sincronizado no WhatsApp Web.
MAX_MESSAGES_PER_CHAT=20000

# Quantas exportações podem rodar ao mesmo tempo. Cada exportação abre um
# Chromium headless — em VPS pequenas mantenha em 1.
MAX_CONCURRENT_EXPORTS=1

# Adiciona pausas entre operações para reduzir carga durante a leitura.
SAFE_MODE=true
CHAT_DELAY_MS=2500
MEDIA_DELAY_MS=800

# Zero significa sem limite.
MAX_CHATS_PER_RUN=0
MAX_MEDIA_PER_RUN=0

# Busca profunda opcional. Tenta solicitar sincronização e repetir a leitura,
# mas não garante histórico completo: o resultado depende do WhatsApp Web.
DEEP_HISTORY_MODE=false
INITIAL_SYNC_WAIT_MS=30000
CHAT_SYNC_TIMEOUT_MS=20000
FETCH_RETRY_COUNT=2
FETCH_RETRY_DELAY_MS=3000

